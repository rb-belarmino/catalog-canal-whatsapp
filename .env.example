# Database (Neon PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Admin Authentication
# Change this to your secure admin password
ADMIN_PASSWORD="sua_senha_admin_aqui"

# Admin Session Secret (32+ random characters used to sign httpOnly session cookies)
ADMIN_SESSION_SECRET="uma_chave_secreta_aleatoria_com_pelo_menos_32_caracteres"

# Media Storage (UploadThing)
# Obtain your token from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN="seu_uploadthing_token_aqui"

# Public App URL (optional, defaults to http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
